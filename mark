current_batch = {
    "active": False,
    "part_number": "",
    "initial_offset": 0,
    "current_count": 0,
}


def get_db_connection():
    conn_str = (
        f"DRIVER={{SQL Server}};SERVER={SQL_CONFIG['server']};"
        f"DATABASE={SQL_CONFIG['database']};UID={SQL_CONFIG['user']};PWD={SQL_CONFIG['password']};"
    )
    return pyodbc.connect(conn_str)


