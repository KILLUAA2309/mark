@app.route("/")
def index():
    return render_template("index.html")


@app.route("/api/status", methods=["GET"])
def get_status():
    raw_count, online = get_plc_count()
    if current_batch["active"]:
        current_batch["current_count"] = max(
            0, raw_count - current_batch["initial_offset"]
        )
    return jsonify(
        {"plc_online": online, "batch": current_batch, "raw_count": raw_count}
    )


@app.route("/api/start_batch", methods=["POST"])
def start_batch():
    data = request.json or {}
    part_num = data.get("part_number", "").strip()
    if not part_num:
        return jsonify({"success": False, "message": "Part number required"}), (
            400
        )

    raw_count, _ = get_plc_count()
    current_batch.update(
        {
            "active": True,
            "part_number": part_num,
            "initial_offset": raw_count,
            "current_count": 0,
        }
    )
    return jsonify({"success": True, "batch": current_batch})


@app.route("/api/stop_batch", methods=["POST"])
def stop_batch():
    if not current_batch["active"]:
        return jsonify({"success": False, "message": "No active batch"}), 400

    data = request.json or {}
    finished_qty = int(data.get("finished_qty", current_batch["current_count"]))

    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute(
            """
            INSERT INTO production_logs (part_number, total_parts, logged_at)
            VALUES (?, ?, GETDATE())
        """,
            (current_batch["part_number"], finished_qty),
        )
        conn.commit()
        conn.close()
    except Exception as e:
        print(f"Database error: {e}")

    current_batch["active"] = False
    return jsonify(
        {"success": True, "message": f"Logged {finished_qty} parts."}
    )


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=False)
